# Caddy reverse proxy — dev stack.
# Serves the built React SPA and fronts the API on http://localhost:8080.
#   /api/*, /healthz, /readyz, /metrics  -> FastAPI (api:8000)   (WS upgrades too)
#   everything else                      -> SPA static files, HTML5 history fallback
# Production TLS lives in Caddyfile.prod (used by docker-compose.prod.yml).

:80 {
	encode gzip

	# Backend: REST + WebSocket (Caddy proxies WS upgrades transparently).
	@api path /api/* /healthz /readyz /metrics
	handle @api {
		reverse_proxy api:8000
	}

	# Frontend SPA: serve static assets, fall back to index.html for client routes.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		# Hardening for the served production build (the Vite dev server is separate).
		# CSP is validated against the actual build: the entry is an external module
		# script (script-src 'self'); styles need 'unsafe-inline' (React inline styles
		# + Google Fonts); the favicon is a data: URI.
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), browsing-topics=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
		-Server
	}
}
