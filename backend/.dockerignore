# Keep the build context small and the image clean.
**/__pycache__/
**/*.pyc
**/*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
*.egg-info/
htmlcov/
.coverage
coverage.xml
*.log
eval_*.csv
schema_*.csv
kb.mhkb.tar.gz
kb_build/
kb_import_test/

# Local data / DBs — never bake into the image
data/*.db
data/*.db-wal
data/*.db-shm
data/uploads/*
data/corpus/
data/exports/
data/schema_mapping_eval/*

# Env + secrets
.env
.env.*
!.env.example

# Editor / OS
.vscode/
.idea/
.DS_Store
