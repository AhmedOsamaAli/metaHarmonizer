# Copy to /home/ubuntu/.config/metaharmonizer/ops-monitor.env with mode 0600.
# Use a dedicated admin API token so /metrics remains protected.
OPS_METRICS_BEARER_TOKEN=

# Slack-compatible incoming webhook. Leave blank to retain reports locally only.
OPS_ALERT_WEBHOOK_URL=

# Set after the encrypted off-host backup and clean restore drill pass.
OPS_REQUIRE_BACKUP=0

# Send the complete daily Markdown report to the webhook as well as alerts.
OPS_SEND_DAILY_REPORT=0