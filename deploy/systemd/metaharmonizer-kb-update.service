[Unit]
Description=MetaHarmonizer verified KB bundle update
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/metaHarmonizer
Environment=KB_DEPLOY_REPO_ROOT=/home/ubuntu/metaHarmonizer
ExecStart=/bin/sh -c 'tool=/home/ubuntu/.local/state/metaharmonizer/deploy/bin/deploy_kb_bundle.sh; if [ ! -x "$tool" ]; then tool=/home/ubuntu/metaHarmonizer/scripts/deploy_kb_bundle.sh; fi; exec "$tool"'
