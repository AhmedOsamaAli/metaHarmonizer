# MetaHarmonizer — environment configuration.
# Copy to .env and adjust:   cp .env.example .env
# .env is git-ignored. This file is the canonical catalogue (spec §6.5).
# Required vars are marked [REQUIRED]; the app fails to boot if they're missing
# (enforced from Sprint 2 once app/core/settings.py lands).

# ── Engine ────────────────────────────────────────────────────────────────
ENGINE_IMPL=metaharmonizer            # metaharmonizer | mock (tests/CI)
ONTOLOGY_ENGINE=1                     # 1 = real ontology mapping (NCIt/UBERON via the engine KB); 0 = curated-dictionary fallback
# METHOD_MODEL_YAML=                   # override engine model registry (optional)
# LLM_THRESHOLD=0.5                    # Stage-4 LLM gate
AUTO_ACCEPT_THRESHOLD=0.9             # confidence at/above which a mapping auto-accepts (else flag-for-review)
# GEMINI_API_KEY=                      # set -> enables Stage-4 LLM (hardest columns + on-demand "LLM re-match"); unset -> stages 1-3 only
# UMLS_API_KEY=                        # needed once for first-run ontology KB build

# ── Offline operation (air-gapped / no-network deploys) ──────────────────────
# Point the engine at the seeded data + models so it never calls out. With the
# offline bundle installed by scripts.seed_kb these load from disk. In Docker
# the compose file already sets these; set them here only for a bare-metal run.
# METAHARMONIZER_DATA_DIR=/app/data          # schema files + corpus/retrieved_ontologies
# KNOWLEDGE_DB_DIR=/app/kb_build              # engine KB (sqlite + faiss indexes)
# MODEL_CACHE_ROOT=                           # ontology model cache (default ~/.metaharmonizer/model_cache)
#
# One-step KB install: the offline bundle is published as a GitHub Release asset.
# scripts.seed_kb and `docker compose --profile kb run --rm kb-import` download +
# sha256-verify + install it automatically when it isn't already present locally
# (works local or in prod). Repoint these to pin your own build or a mirror.
KB_BUNDLE_URL=https://github.com/AhmedOsamaAli/metaHarmonizer/releases/download/kb-latest/kb_offline_bundle.tar.gz
KB_BUNDLE_SHA256=48aca29770223d9d96eb53cd5ef96ae7d4fdb2e8d47b8d6ae819281914f64e5d  # integrity check of the current bundle
HF_HUB_OFFLINE=1                     # load embedding models from cache only — never HuggingFace
TRANSFORMERS_OFFLINE=1               # same, for the transformers layer

# ── Datastore / cache ───────────────────────────────────────────────────────
# Defaults below use the standard Postgres/Redis ports. They match BOTH
# `docker compose up -d postgres redis` AND a native Homebrew/apt install, so on
# macOS/Linux no edit is needed.
# Windows portable dev services (scripts/dev_services.ps1) use :5433 / :6380 to
# avoid clashing with any pre-existing install — if you use them, set instead:
#   DATABASE_URL=postgresql+asyncpg://mh:mh_dev_password@127.0.0.1:5433/metaharmonizer
#   REDIS_URL=redis://127.0.0.1:6380/0
POSTGRES_USER=mh
POSTGRES_PASSWORD=mh_dev_password
POSTGRES_DB=metaharmonizer
DATABASE_URL=postgresql+asyncpg://mh:mh_dev_password@localhost:5432/metaharmonizer   # [REQUIRED from S2]
REDIS_URL=redis://localhost:6379/0

# ── Job pipeline (Sprint 4) ──────────────────────────────────────────
JOB_MODE=inline            # inline (dev, just uvicorn) | queue (prod, arq workers)
JOB_SOFT_TIMEOUT_SEC=300
JOB_HARD_TIMEOUT_SEC=900
JOB_MAX_ATTEMPTS=3
WS_TICKET_TTL_SEC=30                                                   # [REQUIRED from S4]

# ── Object storage ──────────────────────────────────────────────────────────
OBJECT_STORE_URL=file:///app/data/objects   # file://… self-host | s3://… hosted (R2)
# R2_BUCKET=
# R2_KEY=
# R2_SECRET=

# ── Auth / security (Sprint 3) ──────────────────────────────────────────────
AUTH_MODE=jwt                          # jwt | none (self-host internal-network only)
# [REQUIRED] Boot FAILS if this is left as the default or is < 32 bytes.
# Generate one:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-prod-min-32-bytes-long-string
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=30
ALLOWED_EMAIL_DOMAINS=example.com      # comma-separated signup allow-list; empty -> registration closed
COOKIE_SECURE=false                    # auto-enabled when APP_BASE_URL is https://
LOGIN_MAX_FAILURES=5                   # lock the account after N consecutive failed logins
LOGIN_LOCKOUT_MIN=15                   # lockout window in minutes
HIBP_CHECK=true                        # reject breached passwords on signup (fail-open on network error)

# ── Transactional email (verification + password reset) ──────────────────────
# With RESEND_API_KEY set, emails go via Resend. Without it, links are logged to
# the backend console (local dev). The bootstrap admin is auto-verified either way.
# RESEND_API_KEY=                      # re_... from resend.com (Sending access)
EMAIL_FROM=MetaHarmonizer <onboarding@resend.dev>   # verified sender
APP_BASE_URL=http://localhost:5173     # frontend origin, used for links in emails
EMAIL_VERIFY_TTL_MIN=1440              # 24h
PASSWORD_RESET_TTL_MIN=30

# ── Web / CORS ──────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:8080   # [REQUIRED] no wildcards in prod

# ── Upload safety (spec §6.4) ─────────────────────────────────────────────────
MAX_UPLOAD_MB=50          # byte-size guard
MAX_UPLOAD_ROWS=0         # row ceiling; 0 = no cap. Public instances set e.g. 2000.

# ── Data retention (spec §6.8) ────────────────────────────────────────────────
RETENTION_UPLOADS_DAYS=90
RETENTION_EXPORTS_DAYS=30
RETENTION_REVOKED_SESSIONS_DAYS=90
RETENTION_IDLE_STUDY_DAYS=7            # never-completed studies purged this many days after upload
RETENTION_AUDIT_DAYS=365              # audit/activity log retention; 0 = keep forever
RETENTION_ENGINE_PROPOSALS_DAYS=0     # 0 = keep versioned shared machine proposals indefinitely

# ── Federation-lite (G1): signed cross-instance mapping exchange ─────────────
# Optional — only needed when two instances exchange curator-confirmed mappings.
FEDERATION_INSTANCE_ID=local-instance   # this instance's identity in signed bundles
# [REQUIRED in prod if federation is used] Ed25519 signing seed (64 hex chars).
# Without it an internet-facing instance refuses to sign/verify (dev fallback is
# guessable).  Generate:  python -c "import os;print(os.urandom(32).hex())"
# FEDERATION_PRIVATE_KEY=
# Trusted peers: comma-separated instance_id:hex_public_key. Repeat an instance
# id with a second key to trust both during a key-rotation overlap.
# FEDERATION_TRUSTED_KEYS=peer-a:<hexpub>,peer-a:<newhexpub>
FEDERATION_MAX_BUNDLE_AGE_DAYS=30       # reject signed bundles older than this (replay defense); 0 disables
FEDERATION_CLOCK_SKEW_MIN=5             # tolerated future-dating (minutes) on import

# ── Observability ───────────────────────────────────────────────────────────
LOG_LEVEL=info                         # debug | info | warning
# SENTRY_DSN=                          # unset -> stderr structured logs only
