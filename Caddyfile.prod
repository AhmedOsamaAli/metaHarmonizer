# Caddy — production config (automatic HTTPS via Let's Encrypt).
# Used by docker-compose.prod.yml. Requires DOMAIN + ACME_EMAIL in the env.
#   /api/*, /healthz, /readyz, /metrics  -> FastAPI (api:8000)   (WS upgrades too)
#   everything else                      -> SPA static files, HTML5 history fallback

{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode gzip

	# HSTS + hardening headers (TLS is on, so HSTS is safe here). CSP is validated
	# against the actual Vite build (external module script; inline styles + Google
	# Fonts allowed; data: favicon).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), browsing-topics=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
		-Server
	}

	# Backend: REST + WebSocket.
	@api path /api/* /healthz /readyz /metrics
	handle @api {
		reverse_proxy api:8000
	}

	# Frontend SPA.
	handle {
		root * /srv

		# Content-hashed assets never change for a given hash — cache hard.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		# The HTML shell must revalidate each load, or a redeploy leaves the
		# browser on a stale index.html referencing old asset hashes (404 →
		# blank app until a hard refresh).
		@shell not path /assets/*
		header @shell Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
